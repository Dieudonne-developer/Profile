# Pooled Postgres URL (Neon recommended). postgresql:// is converted to postgresql+psycopg://.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooler) URL for Alembic. Leave empty to reuse DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Used to sign JWT access tokens — change this in production
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional: used by the AI writing assistant. If empty, a local rewriter is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public origin of the API (used in generated share links and photo URLs)
PUBLIC_API_URL=http://127.0.0.1:8000
PUBLIC_APP_URL=http://127.0.0.1:5173

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional extra matcher so a Colab/cloud frontend origin is allowed
CORS_ORIGIN_REGEX=

# Optional Google Colab GPU inference URL from the notebook public-proxy cell.
ML_BACKEND_URL=
